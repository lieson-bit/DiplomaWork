# Server
NODE_ENV=development
PORT=3003
APP_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3000

# Database (for local MySQL - adjust as needed)
MYSQL_HOST=localhost
MYSQL_PORT=3309
MYSQL_USER=customer_user
MYSQL_PASSWORD=customer_pass
MYSQL_DATABASE=customer_service_db

# JWT (MUST match user-service)
JWT_SECRET=d6b1cc1128085078faf5a1f9500ca843f31b7574969a0dfae1aa976d509cea2bdd7e316ae765f8b3cfdb09062b3453e9d0533eeb9c28cecd4817b2ef3228d044

# Service Communication
USER_SERVICE_URL=http://localhost:3001
SERVICE_SECRET=shared_service_secret_key_1234567890

# File Upload
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs