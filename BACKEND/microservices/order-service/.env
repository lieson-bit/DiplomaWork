# ============ ORDER SERVICE CONFIGURATION ============
PORT=3004
NODE_ENV=development

# ============ DATABASE CONFIGURATION ============
MYSQL_HOST=order-db
MYSQL_PORT=3306
MYSQL_USER=order_user
MYSQL_PASSWORD=order_pass
MYSQL_DATABASE=order_service_db
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0

# ============ JWT & AUTHENTICATION ============
JWT_SECRET=d6b1cc1128085078faf5a1f9500ca843f31b7574969a0dfae1aa976d509cea2bdd7e316ae765f8b3cfdb09062b3453e9d0533eeb9c28cecd4817b2ef3228d044
JWT_EXPIRES_IN=7d
SERVICE_SECRET=shared_service_secret_key_1234567890

# ============ EXTERNAL SERVICES ============
USER_SERVICE_URL=http://user-service:3001
DRIVER_SERVICE_URL=http://driver-service:3002
CUSTOMER_SERVICE_URL=http://customer-service:3003

# ============ CORS CONFIGURATION ============
CORS_ORIGIN=http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,x-service-secret

# ============ UPLOAD CONFIGURATION ============
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# ============ LOGGING CONFIGURATION ============
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs
LOG_MAX_SIZE=10485760  # 10MB
LOG_MAX_FILES=5

# ============ RATE LIMITING ============
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============ WEBSOCKET CONFIGURATION ============
WEBSOCKET_PORT=8080
WEBSOCKET_HEARTBEAT_INTERVAL=30000  # 30 seconds
WEBSOCKET_MAX_CLIENTS=1000

# ============ KNAPSACK OPTIMIZATION ============
MAX_DISTANCE_PER_VEHICLE=50  # km
VEHICLE_CAPACITY_WEIGHT=100  # kg
VEHICLE_CAPACITY_VOLUME=5    # m³
MAX_ITEMS_PER_VEHICLE=20

# ============ PRICING CONFIGURATION ============
BASE_PRICE=5.00
DISTANCE_FEE_PER_KM=2.00
WEIGHT_FEE_PER_KG=0.50
VOLUME_FEE_PER_M3=10.00
PLATFORM_FEE_PERCENT=15.00
TAX_PERCENT=10.00
RUSH_FEE_PERCENT=20.00
FUEL_SURCHARGE_PERCENT=10.00

# ============ BULK ORDER DISCOUNTS ============
BULK_DISCOUNT_10_ORDERS=5
BULK_DISCOUNT_20_ORDERS=10
BULK_DISCOUNT_50_ORDERS=15