# Server Configuration
PORT=3004
NODE_ENV=development
APP_URL=http://localhost:3004

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=order_user
MYSQL_PASSWORD=order_pass
MYSQL_DATABASE=order_service_db
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0

# JWT Authentication
JWT_SECRET=d6b1cc1128085078faf5a1f9500ca843f31b7574969a0dfae1aa976d509cea2bdd7e316ae765f8b3cfdb09062b3453e9d0533eeb9c28cecd4817b2ef3228d044

# Service Communication
USER_SERVICE_URL=http://localhost:3001
DRIVER_SERVICE_URL=http://localhost:3002
CUSTOMER_SERVICE_URL=http://localhost:3003
SERVICE_SECRET=shared_service_secret_key_1234567890

# Service Timeouts (milliseconds)
USER_SERVICE_TIMEOUT=10000
DRIVER_SERVICE_TIMEOUT=10000
CUSTOMER_SERVICE_TIMEOUT=10000

# Service Retry Configuration
USER_SERVICE_RETRIES=3
DRIVER_SERVICE_RETRIES=3
CUSTOMER_SERVICE_RETRIES=3

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email Configuration (optional - comment out if not using)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@orderservice.com

# WebSocket Configuration
WEBSOCKET_PORT=8080
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT=30000
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_CONNECTION_TIMEOUT=300000

# Logging Configuration
LOG_DIR=./logs
LOG_LEVEL=info

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Development Debugging (optional)
DEBUG=true

# Session/Cookie Security (if using sessions)
COOKIE_SECRET=cookie_secret_1234567890
SESSION_SECRET=session_secret_1234567890

# External Service API Keys (optional - uncomment and set as needed)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# GEOCODING_API_KEY=your_geocoding_api_key_here
# ROUTING_API_KEY=your_routing_api_key_here
# STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=10000
HEALTH_CHECK_RETRIES=3