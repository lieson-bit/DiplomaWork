# Server Configuration
PORT=3004
NODE_ENV=development
APP_URL=http://localhost:3004

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=order_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=order_service_db
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_change_this

# Service Communication
USER_SERVICE_URL=http://localhost:3001
DRIVER_SERVICE_URL=http://localhost:3002
CUSTOMER_SERVICE_URL=http://localhost:3003
SERVICE_SECRET=your_service_secret_here_change_this
USER_SERVICE_TIMEOUT=10000
USER_SERVICE_RETRIES=3

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

Email Configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@orderservice.com

# WebSocket Configuration
WEBSOCKET_PORT=8080
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT=30000
WEBSOCKET_MAX_CONNECTIONS=1000

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100